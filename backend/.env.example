PORT=5000
MONGO_URI=mongodb://localhost:27017/tiffin_service
# Generate a unique, high-entropy secret for each deployment.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated MongoDB User _id values allowed to review vendor applications.
# Create an administrator account, then configure its database _id here.
# Never use unverified email addresses as administrator credentials.
ADMIN_USER_IDS=replace-with-admin-user-object-id
